class Assignment2Benchmarks {

    // Q1: String vs StringBuilder vs StringBuffer
    public static void runQ1Benchmark() {
        int tickets = 1500;
        int fields = 35;

        long t1 = System.nanoTime();
        for (int i = 0; i < tickets; i++) {
            String ticket = "";
            for (int f = 0; f < fields; f++) {
                ticket = ticket + "Field" + f + ":Val" + i + "|";
            }
        }
        long stringTime = (System.nanoTime() - t1) / 1_000_000;

        long t2 = System.nanoTime();
        for (int i = 0; i < tickets; i++) {
            StringBuilder sb = new StringBuilder(fields * 15);
            for (int f = 0; f < fields; f++) {
                sb.append("Field").append(f).append(":Val").append(i).append("|");
            }
            String res = sb.toString();
        }
        long builderTime = (System.nanoTime() - t2) / 1_000_000;

        long t3 = System.nanoTime();
        for (int i = 0; i < tickets; i++) {
            StringBuffer sbuf = new StringBuffer(fields * 15);
            for (int f = 0; f < fields; f++) {
                sbuf.append("Field").append(f).append(":Val").append(i).append("|");
            }
            String res = sbuf.toString();
        }
        long bufferTime = (System.nanoTime() - t3) / 1_000_000;

        System.out.printf("Workload (%d tickets x %d fields):%n", tickets, fields);
        System.out.printf("  String (+)      : %d ms (O(n^2) intermediate objects: ~%d)%n", stringTime, tickets * fields);
        System.out.printf("  StringBuilder   : %d ms (O(n) single buffer per ticket)%n", builderTime);
        System.out.printf("  StringBuffer    : %d ms (O(n) synchronized overhead)%n", bufferTime);
    }

    // Q2: ArrayList vs LinkedList vs ArrayDeque
    public static void runQ2Benchmark() {
        int n = 15_000;
        List<Integer> arrayList = new ArrayList<>();
        List<Integer> linkedList = new LinkedList<>();
        Deque<Integer> arrayDeque = new ArrayDeque<>();

        long t1 = System.nanoTime();
        for (int i = 0; i < n; i++) arrayList.add(0, i);
        long alFront = (System.nanoTime() - t1) / 1_000_000;

        long t2 = System.nanoTime();
        for (int i = 0; i < n; i++) linkedList.add(0, i);
        long llFront = (System.nanoTime() - t2) / 1_000_000;

        long t3 = System.nanoTime();
        for (int i = 0; i < n; i++) arrayDeque.addFirst(i);
        long adFront = (System.nanoTime() - t3) / 1_000_000;

        long t4 = System.nanoTime();
        for (int i = 0; i < 5000; i++) arrayList.get(n / 2);
        long alGet = (System.nanoTime() - t4) / 1_000;

        long t5 = System.nanoTime();
        for (int i = 0; i < 5000; i++) linkedList.get(n / 2);
        long llGet = (System.nanoTime() - t5) / 1_000;

        System.out.printf("Insert %d items at front -> ArrayList: %d ms | LinkedList: %d ms | ArrayDeque: %d ms%n",
                n, alFront, llFront, adFront);
        System.out.printf("5,000 get(middle) calls  -> ArrayList: %d us | LinkedList: %d us%n",
                alGet, llGet);
    }

    // Q4: HashMap vs LinkedHashMap vs TreeMap
    public static void runQ4Benchmark() {
        int n = 10_000;
        Map<String, Integer> hashMap = new HashMap<>();
        Map<String, Integer> linkedMap = new LinkedHashMap<>();
        Map<String, Integer> treeMap = new TreeMap<>();

        for (int i = 0; i < n; i++) {
            String code = String.format("MED-%05d", (i * 37) % n);
            hashMap.put(code, 100);
            linkedMap.put(code, 100);
            treeMap.put(code, 100);
        }

        int lookups = 100_000;
        long t1 = System.nanoTime();
        for (int i = 0; i < lookups; i++) hashMap.get("MED-00500");
        long hmTime = (System.nanoTime() - t1) / 1_000;

        long t2 = System.nanoTime();
        for (int i = 0; i < lookups; i++) linkedMap.get("MED-00500");
        long lhmTime = (System.nanoTime() - t2) / 1_000;

        long t3 = System.nanoTime();
        for (int i = 0; i < lookups; i++) treeMap.get("MED-00500");
        long tmTime = (System.nanoTime() - t3) / 1_000;

        System.out.printf("100,000 lookups (N=%d) -> HashMap: %d us | LinkedHashMap: %d us | TreeMap: %d us%n",
                n, hmTime, lhmTime, tmTime);
        System.out.println("  LinkedHashMap preserves insertion order; TreeMap preserves sorted code order.");
    }

    // Q7: Day-4 Redesign (Eliminating Repeated Re-Sorting in Leaderboard)
    public static void runQ7RedesignValidation() {
        int teamsCount = 5_000;
        int queries = 200;

        Comparator<Team> byRank = (a, b) -> {
            int cmpPoints = Integer.compare(b.points, a.points);
            if (cmpPoints != 0) return cmpPoints;
            int cmpGoal = Integer.compare(b.goalDiff, a.goalDiff);
            if (cmpGoal != 0) return cmpGoal;
            return a.name.compareTo(b.name);
        };

        Leaderboard<Team> originalBoard = new Leaderboard<>(byRank);
        for (int i = 0; i < teamsCount; i++) {
            originalBoard.add(new Team("Team" + i, i % 50, i % 20));
        }

        long t1 = System.nanoTime();
        for (int q = 0; q < queries; q++) {
            List<Team> r = originalBoard.ranking();
        }
        long originalTime = (System.nanoTime() - t1) / 1_000_000;

        TreeSet<Team> sortedCache = new TreeSet<>(byRank);
        for (int i = 0; i < teamsCount; i++) {
            sortedCache.add(new Team("Team" + i, i % 50, i % 20));
        }

        long t2 = System.nanoTime();
        for (int q = 0; q < queries; q++) {
            Collection<Team> r = Collections.unmodifiableCollection(sortedCache);
        }
        long redesignedTime = (System.nanoTime() - t2) / 1_000_000;

        System.out.printf("200 ranking() reads across %d teams:%n", teamsCount);
        System.out.printf("  Original (re-sort every read) : %d ms%n", originalTime);
        System.out.printf("  Redesigned (TreeSet cache)    : %d ms%n", redesignedTime);
    }
}

