// TASK 1.2: Repaired FeeWindow (Separated UI + FeeService + SwingWorker)
// ============================================================================
class FeeService {
    public String processPayment(String regNo, String amountText) throws Exception {
        if (regNo == null || regNo.trim().isEmpty()) {
            throw new IllegalArgumentException("Register number is required.");
        }
        double amt;
        try {
            amt = Double.parseDouble(amountText.trim());
        } catch (NumberFormatException e) {
            throw new IllegalArgumentException("Enter a valid numeric amount.");
        }
        if (amt <= 0) {
            throw new IllegalArgumentException("Amount must be greater than zero.");
        }
        Thread.sleep(200); // Simulates background DB call off EDT
        return String.format("Receipt #FEE-%d | RegNo: %s | Paid: Rs %.2f",
                1042, regNo.trim().toUpperCase(), amt);
    }
}

class FeeWindow extends JFrame {
    private final JTextField regNo = new JTextField(12);
    private final JTextField amount = new JTextField(10);
    private final JLabel status = new JLabel("Ready");
    private final FeeService service = new FeeService();
    private String lastReceipt = "No payment completed yet.";

    public FeeWindow() {
        super("Task 1.2 - Repaired Student Fee Window");
        setLayout(new GridLayout(4, 2, 8, 8));
        JButton pay = new JButton("Pay");
        JButton clear = new JButton("Clear");
        JButton receipt = new JButton("Receipt");

        add(new JLabel("Register No:")); add(regNo);
        add(new JLabel("Amount (Rs):")); add(amount);
        add(pay); add(clear);
        add(receipt); add(status);

        pay.addActionListener(e -> {
            pay.setEnabled(false);
            status.setText("Processing...");
            new SwingWorker<String, Void>() {
                @Override
                protected String doInBackground() throws Exception {
                    return service.processPayment(regNo.getText(), amount.getText());
                }
                @Override
                protected void done() {
                    try {
                        lastReceipt = get();
                        status.setText("Paid successfully!");
                    } catch (Exception ex) {
                        status.setText("Error: " + ex.getCause().getMessage());
                    } finally {
                        pay.setEnabled(true);
                    }
                }
            }.execute();
        });

        clear.addActionListener(e -> {
            regNo.setText("");
            amount.setText("");
            status.setText("Cleared");
        });

        receipt.addActionListener(e -> JOptionPane.showMessageDialog(this, lastReceipt, "Fee Receipt", JOptionPane.INFORMATION_MESSAGE));

        setSize(380, 180);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(DISPOSE_ON_CLOSE);
    }
}

