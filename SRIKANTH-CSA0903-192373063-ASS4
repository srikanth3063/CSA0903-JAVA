class EventRegistrationApp extends JFrame {
    private final JTextField regNoField = new JTextField(10);
    private final JTextField nameField = new JTextField(12);
    private final JComboBox<String> eventBox = new JComboBox<>(new String[]{"Hackathon", "RoboWars", "CodeSprint", "UI/UX Jam"});
    private final JComboBox<String> filterBox = new JComboBox<>(new String[]{"All Events", "Hackathon", "RoboWars", "CodeSprint", "UI/UX Jam"});
    private final DefaultTableModel tableModel = new DefaultTableModel(new String[]{"Reg No", "Student Name", "Event"}, 0);
    private final JLabel statusBar = new JLabel("Ready");
    private final List<String[]> records = new ArrayList<>();

    public EventRegistrationApp() {
        super("Task 6 - Campus Event Registration Portal");
        setLayout(new BorderLayout(6, 6));

        JMenuBar menuBar = new JMenuBar();
        JMenu fileMenu = new JMenu("File");
        JMenuItem exportItem = new JMenuItem("Export CSV");
        JMenuItem exitItem = new JMenuItem("Exit");
        fileMenu.add(exportItem);
        fileMenu.add(exitItem);
        menuBar.add(fileMenu);
        setJMenuBar(menuBar);

        JPanel formPanel = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 6));
        JButton registerBtn = new JButton("Register");
        formPanel.add(new JLabel("Reg No:")); formPanel.add(regNoField);
        formPanel.add(new JLabel("Name:")); formPanel.add(nameField);
        formPanel.add(new JLabel("Event:")); formPanel.add(eventBox);
        formPanel.add(registerBtn);
        add(formPanel, BorderLayout.NORTH);

        JTable table = new JTable(tableModel);
        add(new JScrollPane(table), BorderLayout.CENTER);

        JPanel southPanel = new JPanel(new BorderLayout());
        JPanel filterPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        filterPanel.add(new JLabel("Filter by Event:"));
        filterPanel.add(filterBox);
        southPanel.add(filterPanel, BorderLayout.NORTH);
        southPanel.add(statusBar, BorderLayout.SOUTH);
        add(southPanel, BorderLayout.SOUTH);

        records.add(new String[]{"192311001", "Arun", "Hackathon"});
        records.add(new String[]{"192311002", "Divya", "CodeSprint"});
        refreshTable("All Events");

        registerBtn.addActionListener(e -> {
            String reg = regNoField.getText().trim().toUpperCase();
            String name = nameField.getText().trim();
            String ev = (String) eventBox.getSelectedItem();

            if (reg.isEmpty() || name.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Reg No and Student Name are required.", "Validation Error", JOptionPane.ERROR_MESSAGE);
                return;
            }
            for (String[] row : records) {
                if (row[0].equals(reg) && row[2].equals(ev)) {
                    JOptionPane.showMessageDialog(this, "Duplicate Registration: " + reg + " is already registered for " + ev, "Duplicate Error", JOptionPane.WARNING_MESSAGE);
                    return;
                }
            }

            registerBtn.setEnabled(false);
            statusBar.setText("Saving to database...");
            new SwingWorker<Void, Void>() {
                @Override
                protected Void doInBackground() {
                    saveToDatabaseOrMemory(reg, name, ev);
                    return null;
                }
                @Override
                protected void done() {
                    regNoField.setText("");
                    nameField.setText("");
                    refreshTable((String) filterBox.getSelectedItem());
                    statusBar.setText("Registered " + reg + " for " + ev);
                    registerBtn.setEnabled(true);
                }
            }.execute();
        });

        filterBox.addActionListener(e -> refreshTable((String) filterBox.getSelectedItem()));
        exportItem.addActionListener(e -> {
            try (PrintWriter pw = new PrintWriter(new FileWriter("event_registrations.csv"))) {
                pw.println("RegNo,Name,Event");
                for (String[] r : records) pw.println(String.join(",", r));
                statusBar.setText("Exported " + records.size() + " rows to event_registrations.csv");
            } catch (Exception ex) {
                statusBar.setText("Export failed: " + ex.getMessage());
            }
        });
        exitItem.addActionListener(e -> dispose());

        setSize(680, 380);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(DISPOSE_ON_CLOSE);
    }

    private void saveToDatabaseOrMemory(String reg, String name, String event) {
        String url = "jdbc:mysql://localhost:3306/campus_events";
        try (Connection conn = DriverManager.getConnection(url, "root", "");
             PreparedStatement ps = conn.prepareStatement("INSERT INTO registrations(reg_no, student_name, event_name) VALUES (?, ?, ?)")) {
            ps.setString(1, reg);
            ps.setString(2, name);
            ps.setString(3, event);
            ps.executeUpdate();
        } catch (SQLException ignored) {
        }
        records.add(new String[]{reg, name, event});
    }

    private void refreshTable(String filter) {
        tableModel.setRowCount(0);
        for (String[] r : records) {
            if ("All Events".equals(filter) || r[2].equals(filter)) {
                tableModel.addRow(r);
            }
        }
    }
}

