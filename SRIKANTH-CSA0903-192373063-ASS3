// Q6: Complete the Code - TokenCounter (Producer-Consumer wait/notifyAll)
// ============================================================================
class TokenCounter {
    private final int[] buffer = new int[5];
    private int count = 0, in = 0, out = 0;

    public synchronized void put(int token) throws InterruptedException {
        // TODO 1: Wait while the counter is full, add the token at position in, then wake waiting threads
        while (count == buffer.length) {
            wait();
        }
        buffer[in] = token;
        in = (in + 1) % buffer.length;
        count++;
        notifyAll();
    }

    public synchronized int take() throws InterruptedException {
        // TODO 2: Wait while the counter is empty, remove the token at position out, wake waiting threads and return the token
        while (count == 0) {
            wait();
        }
        int token = buffer[out];
        out = (out + 1) % buffer.length;
        count--;
        notifyAll();
        return token;
    }

    public static void runQ6Demo() throws InterruptedException {
        TokenCounter counter = new TokenCounter();
        int[] collected = new int[2];

        Thread cook = new Thread(() -> {
            try {
                for (int t = 1; t <= 20; t++) counter.put(t);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        });

        Thread[] students = new Thread[2];
        for (int s = 0; s < 2; s++) {
            final int id = s;
            students[s] = new Thread(() -> {
                try {
                    for (int k = 0; k < 10; k++) collected[id] += counter.take();
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                }
            });
        }

        cook.start();
        for (Thread t : students) t.start();
        cook.join();
        for (Thread t : students) t.join();

        System.out.println("Sum of tokens collected: " + (collected[0] + collected[1]) + " (expected 210)");
    }
}

// ============================================================================
// Q7: Concurrent, Fault-Tolerant Semester Result Processor (ExecutorService)
// ============================================================================
class ResultProcessorDemo {
    public static void runQ7Demo() throws InterruptedException {
        int totalFiles = 200;
        int[] poolSizes = {1, 2, 4, 8};

        for (int poolSize : poolSizes) {
            ExecutorService executor = Executors.newFixedThreadPool(poolSize);
            ConcurrentHashMap<String, Integer> validResults = new ConcurrentHashMap<>();
            AtomicInteger failureCount = new AtomicInteger(0);
            List<Callable<Boolean>> tasks = new ArrayList<>();

            for (int i = 1; i <= totalFiles; i++) {
                final int fileId = i;
                Callable<Boolean> task = new Callable<Boolean>() {
                    @Override
                    public Boolean call() throws Exception {
                        Thread.sleep(1);
                        if (fileId % 20 == 0) {
                            failureCount.incrementAndGet();
                            throw new IOException("Corrupt/Missing file: Student_" + fileId);
                        }
                        validResults.put("Student_" + fileId, 75 + (fileId % 25));
                        return true;
                    }
                };
                tasks.add(task);
            }

            long start = System.nanoTime();
            List<Future<Boolean>> futures = executor.invokeAll(tasks);
            for (Future<Boolean> f : futures) {
                try {
                    f.get();
                } catch (ExecutionException ignored) {
                }
            }
            executor.shutdown();
            long elapsedMs = (System.nanoTime() - start) / 1_000_000;

            System.out.printf("Pool Size = %d -> Time: %3d ms | Successes: %d | Failures Isolated: %d%n",
                    poolSize, elapsedMs, validResults.size(), failureCount.get());
        }
    }
}

