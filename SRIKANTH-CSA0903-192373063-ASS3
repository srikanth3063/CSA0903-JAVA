class ExamException extends Exception {
    ExamException(String message) { super(message); }
    ExamException(String message, Throwable cause) { super(message, cause); }
}

class SubmissionStorageException extends ExamException {
    SubmissionStorageException(String message, Throwable cause) {
        super(message, cause);
    }
}

class Storage {
    void save(String fileName, long sizeKb) throws SubmissionStorageException {
        try {
            if (sizeKb > 500) throw new IOException("Disk quota exceeded");
            System.out.println("Saved " + fileName);
        } catch (IOException e) {
            // TODO 1: Wrap the IOException in a SubmissionStorageException, keeping IOException as its cause
            throw new SubmissionStorageException("Could not store " + fileName, e);
        }
    }
}

class StorageDemo {
    public static void runQ2Demo() {
        Storage storage = new Storage();
        try {
            storage.save("answer01.pdf", 120);
            storage.save("answer02.pdf", 800);
        } catch (ExamException e) {
            System.out.println("Error: " + e.getMessage());
            System.out.println("Cause: " + (e.getCause() != null ? e.getCause().getMessage() : "null"));
        }
    }
}

// ============================================================================
// Q3: Resource Safety & try-with-resources Simulation
// ============================================================================
class SimulatedStoreFile implements AutoCloseable {
    final String name;
    final boolean corrupt;
    boolean closed = false;

    SimulatedStoreFile(String name, boolean corrupt) {
        this.name = name;
        this.corrupt = corrupt;
    }

    int readSales() throws IOException {
        if (corrupt) throw new IOException("Corrupt data in " + name);
        return 1000;
    }

    @Override
    public void close() {
        closed = true;
    }
}

class SalesReportDemo {
    public static void runQ3Demo() {
        List<SimulatedStoreFile> files = Arrays.asList(
            new SimulatedStoreFile("StoreA.csv", false),
            new SimulatedStoreFile("StoreB.csv", true),
            new SimulatedStoreFile("StoreC.csv", false)
        );

        int total = 0;
        for (SimulatedStoreFile f : files) {
            try (SimulatedStoreFile resource = f) {
                total += resource.readSales();
            } catch (IOException e) {
                System.out.println("  [LOG] Failed reading " + f.name + ": " + e.getMessage());
            }
        }
        int leaked = 0;
        for (SimulatedStoreFile f : files) {
            if (!f.closed) leaked++;
        }
        System.out.println("  Total Sales Computed: Rs " + total + " | Leaked File Handles: " + leaked);
    }
}

// ============================================================================
// Q4: Thread Creation & Thread Life Cycle (Thread & Runnable)
// ============================================================================
class ScannerTask implements Runnable {
    private final String stationName;
    private final int scripts;
    private int scanned = 0;

    ScannerTask(String stationName, int scripts) {
        this.stationName = stationName;
        this.scripts = scripts;
    }

    @Override
    public void run() {
        try {
            for (int i = 0; i < scripts; i++) {
                Thread.sleep(10);
                scanned++;
            }
            System.out.println("  " + stationName + " finished scanning " + scanned + " scripts.");
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }

    public int getScanned() { return scanned; }
}

class ScannerStationDemo {
    public static void runQ4Demo() throws InterruptedException {
        ScannerTask[] tasks = new ScannerTask[4];
        Thread[] workers = new Thread[4];

        for (int i = 0; i < 4; i++) {
            tasks[i] = new ScannerTask("Station-" + (i + 1), 5);
            workers[i] = new Thread(tasks[i]);
            workers[i].start();
        }

        System.out.println("  Station-1 isAlive right after start(): " + workers[0].isAlive());
        int total = 0;
        for (int i = 0; i < 4; i++) {
            workers[i].join();
            total += tasks[i].getScanned();
        }
        System.out.println("  All stations finished. Total scripts scanned: " + total + " | Station-1 isAlive: " + workers[0].isAlive());
    }
}

// ============================================================================
// Q5: Complete the Code - SeatBooking (Race Condition & Synchronization)
// ============================================================================
class SeatBooking {
    private final boolean[] booked;
    private int bookingsMade = 0;

    SeatBooking(int seats) {
        booked = new boolean[seats];
    }

    // TODO 1: Make the check-then-book operation atomic so that a seat can never be sold twice
    public synchronized boolean book(int seat) {
        if (!booked[seat]) {
            booked[seat] = true;
            bookingsMade++;
            return true;
        }
        return false;
    }

    public static void runQ5Demo() throws InterruptedException {
        SeatBooking screen = new SeatBooking(10);
        Thread[] users = new Thread[100];
        for (int i = 0; i < users.length; i++) {
            final int seat = i % 10;
            users[i] = new Thread(() -> screen.book(seat));
            users[i].start();
        }
        for (Thread t : users) t.join();
        System.out.println("Seats sold: " + screen.bookingsMade);
    }
}

