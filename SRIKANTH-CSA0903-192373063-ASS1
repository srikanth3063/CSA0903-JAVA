interface Chargeable {
    double chargingFee(int kWh);
}

abstract class SimpleVehicle {
    private final String regNo;

    protected SimpleVehicle(String regNo) {
        this.regNo = regNo;
    }

    public String getRegNo() {
        return regNo;
    }

    protected abstract double ratePerHour();

    public double calculateFee(int minutes) {
        if (minutes <= 0) return 0.0;
        int hours = (minutes + 59) / 60;
        return hours * ratePerHour();
    }

    @Override
    public boolean equals(Object o) {
        return o instanceof SimpleVehicle && regNo.equals(((SimpleVehicle) o).regNo);
    }

    @Override
    public int hashCode() {
        return regNo.hashCode();
    }
}

class SimpleTwoWheeler extends SimpleVehicle {
    SimpleTwoWheeler(String regNo) {
        super(regNo);
    }

    @Override
    protected double ratePerHour() {
        return 10;
    }
}

class SimpleCar extends SimpleVehicle {
    SimpleCar(String regNo) {
        super(regNo);
    }

    @Override
    protected double ratePerHour() {
        return 30;
    }
}

class SimpleElectricCar extends SimpleCar implements Chargeable {
    SimpleElectricCar(String regNo) {
        super(regNo);
    }

    @Override
    public double chargingFee(int kWh) {
        return kWh * 12.0;
    }
}

class FeeDemo {
    public static void runTask8Demo() {
        SimpleVehicle[] parked = {
            new SimpleTwoWheeler("TN01A1"),
            new SimpleCar("TN02B2"),
            new SimpleElectricCar("TN03C3")
        };
        for (SimpleVehicle v : parked) {
            double fee = v.calculateFee(130);
            if (v instanceof Chargeable) {
                Chargeable c = (Chargeable) v;
                fee += c.chargingFee(10);
            }
            System.out.println(v.getClass().getSimpleName().replace("Simple", "") + " " + v.getRegNo() + " -> Rs " + fee);
        }
        System.out.println(new SimpleCar("TN02B2").equals(new SimpleElectricCar("TN02B2")));
    }
}

