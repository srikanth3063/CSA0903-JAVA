// ============================================================================
// Q1: ATM Withdrawal Simulation (Exception Hierarchy, Multi-catch, finally)
// ============================================================================
class InsufficientFundsException extends Exception {
    public InsufficientFundsException(String msg) { super(msg); }
}

class ATMSimulation {
    private double balance = 5000.0;

    public void withdraw(String amountInput, boolean cardReaderOk) {
        try {
            if (!cardReaderOk) {
                throw new IOException("Card-reader hardware/file missing");
            }
            double amount = Double.parseDouble(amountInput); // Throws NumberFormatException
            if (amount <= 0) {
                throw new ArithmeticException("Withdrawal amount must be positive: " + amount);
            }
            if (amount > balance) {
                throw new InsufficientFundsException("Requested Rs " + amount + " exceeds balance Rs " + balance);
            }
            balance -= amount;
            System.out.println("  [SUCCESS] Dispensed Rs " + amount + " | Remaining Balance: Rs " + balance);
        } catch (NumberFormatException | ArithmeticException e) {
            // Valid multi-catch: both are sibling subclasses of RuntimeException
            System.out.println("  [INPUT ERROR] " + e.getClass().getSimpleName() + ": " + e.getMessage());
        } catch (InsufficientFundsException e) {
            System.out.println("  [BUSINESS ERROR] " + e.getMessage());
        } catch (IOException e) {
            System.out.println("  [HARDWARE ERROR] " + e.getMessage());
        } finally {
            System.out.println("  [FINALLY] Card ejected & session closed.");
        }
    }

    public static void runQ1Demo() {
        ATMSimulation atm = new ATMSimulation();
        System.out.println("Test 1 (Valid 1500):");
        atm.withdraw("1500", true);
        System.out.println("Test 2 (Non-numeric 'abc'):");
        atm.withdraw("abc", true);
        System.out.println("Test 3 (Negative -200):");
        atm.withdraw("-200", true);
        System.out.println("Test 4 (Exceeds balance 9000):");
        atm.withdraw("9000", true);
        System.out.println("Test 5 (Card reader failure):");
        atm.withdraw("500", false);
    }
}

