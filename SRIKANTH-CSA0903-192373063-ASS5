// TASK B3: PassLoader (JDBC Batch Processing & Transaction Rollback Safety)
// ============================================================================
class PassLoader {
    /** Loads all passes in one transaction, in batches of 1,000 rows. Returns the number of rows loaded.[cite: 5] */
    public static int loadAll(Connection con, List<String[]> passes) throws SQLException {
        String sql = "INSERT INTO bus_pass(pass_id, reg_no, name, route_no, amount) VALUES (?, ?, ?, ?, ?)";
        boolean oldAutoCommit = con.getAutoCommit();
        con.setAutoCommit(false); // Begin transaction[cite: 5]
        try (PreparedStatement ps = con.prepareStatement(sql)) {
            int n = 0;
            for (String[] p : passes) {
                ps.setString(1, p[0]);
                ps.setString(2, p[1]);
                ps.setString(3, p[2]);
                ps.setInt(4, Integer.parseInt(p[3]));
                ps.setDouble(5, Double.parseDouble(p[4]));
                ps.addBatch();
                n++;
                if (n % 1000 == 0) {
                    ps.executeBatch();
                }
            }
            ps.executeBatch(); // Execute remaining batch items

            con.commit();
            return n;

        } catch (SQLException | RuntimeException e) {
            con.rollback(); // Rollback on failure[cite: 5]
            throw e;
        } finally {
            con.setAutoCommit(oldAutoCommit);
        }
    }

    public static void runMockJdbcDemo() {
        System.out.println("JDBC Batch & Transaction Simulation:");
        try {
            Connection conn = DriverManager.getConnection("jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1", "sa", "");
            try (Statement stmt = conn.createStatement()) {
                stmt.execute("CREATE TABLE bus_pass (pass_id VARCHAR(20), reg_no VARCHAR(20), name VARCHAR(50), route_no INT, amount DOUBLE)");
            }

            List<String[]> batchData = new ArrayList<>();
            batchData.add(new String[]{"P2001", "19232001", "Karthik", "5", "3500.0"});
            batchData.add(new String[]{"P2002", "19232002", "Sneha", "3", "4000.0"});

            int loaded = loadAll(conn, batchData);
            System.out.println("  Successfully loaded batch records: " + loaded);

            // Test Rollback safety with invalid data
            List<String[]> faultyData = new ArrayList<>();
            faultyData.add(new String[]{"P2003", "19232003", "Rahul", "2", "2500.0"});
            faultyData.add(new String[]{"P2004", "19232004", "Pooja", "INVALID_INT_ROUTE", "3000.0"});

            try {
                loadAll(conn, faultyData);
            } catch (Exception e) {
                System.out.println("  Caught expected transaction failure: " + e.getMessage());
                System.out.println("  Transaction rolled back successfully. Database remains clean.");
            }

            conn.close();
        } catch (Exception e) {
            System.out.println("  Mock JDBC notice: " + e.getMessage());
        }
    }
}

