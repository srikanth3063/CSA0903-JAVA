// ============================================================================
// TASK B1: PassStore (File-based Bus-Pass Record Management & Damage Resilience)
// ============================================================================
class PassStore {
    private final Path file;

    PassStore(Path file) {
        this.file = file;
    }

    public void add(String passId, String regNo, String name, int route, double amount) throws IOException {
        try (BufferedWriter w = Files.newBufferedWriter(file, StandardOpenOption.CREATE, StandardOpenOption.APPEND)) {
            w.write(String.join(",", passId, regNo, name, String.valueOf(route), String.valueOf(amount)));
            w.newLine();
        }
    }

    /** Returns the five fields of the pass with the given ID, or null if not found. */
    public String[] find(String passId) throws IOException {
        try (BufferedReader reader = Files.newBufferedReader(file)) {
            String line;
            while ((line = reader.readLine()) != null) {
                if (line.trim().isEmpty()) continue;
                String[] fields = line.split(",");
                // Validate record structure (resilience against damaged lines)
                if (fields.length == 5 && fields[0].trim().equals(passId)) {
                    return fields;
                }
            }
        }
        return null;
    }

    public static void runTaskB1Demo() throws IOException {
        Path f = Files.createTempFile("passes", ".csv");
        PassStore store = new PassStore(f);
        store.add("P1001", "192311001", "Arun", 12, 4500);
        // Injecting a damaged line deliberately
        Files.writeString(f, "P1002,DAMAGED_LINE\n", StandardOpenOption.APPEND);
        store.add("P1003", "192311003", "Divya", 7, 3800);

        System.out.println("Finding P1003: " + Arrays.toString(store.find("P1003")));
        System.out.println("Finding P1002 (Damaged): " + Arrays.toString(store.find("P1002")));
        Files.delete(f);
    }
}

// ============================================================================
// TASK A2 / B1.3: Buffering Benchmark & Demonstration
// ============================================================================
class BufferingBenchmark {
    public static void runBenchmark() throws IOException {
        Path tempFile = Files.createTempFile("log_benchmark", ".txt");
        try (BufferedWriter bw = Files.newBufferedWriter(tempFile)) {
            for (int i = 0; i < 20000; i++) {
                bw.write("Attendance log record entry number " + i + " status present\n");
            }
        }

        long startUnbuffered = System.nanoTime();
        int lineCountUnbuffered = 0;
        try (InputStream in = Files.newInputStream(tempFile)) {
            int b;
            while ((b = in.read()) != -1) {
                if (b == '\n') lineCountUnbuffered++;
            }
        }
        long timeUnbuffered = (System.nanoTime() - startUnbuffered) / 1_000_000;

        long startBuffered = System.nanoTime();
        int lineCountBuffered = 0;
        try (BufferedReader br = Files.newBufferedReader(tempFile)) {
            while (br.readLine() != null) {
                lineCountBuffered++;
            }
        }
        long timeBuffered = (System.nanoTime() - startBuffered) / 1_000_000;

        System.out.println("Buffering Benchmark (20,000 lines):");
        System.out.println("  Unbuffered Byte-by-Byte : " + timeUnbuffered + " ms (Lines: " + lineCountUnbuffered + ")");
        System.out.println("  Buffered Line Reader    : " + timeBuffered + " ms (Lines: " + lineCountBuffered + ")");
        System.out.println("  Conclusion: Buffering minimizes OS syscall overhead drastically.");
        Files.delete(tempFile);
    }
}

