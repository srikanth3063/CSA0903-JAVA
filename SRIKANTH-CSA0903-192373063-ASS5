// TASK B2 / A5: SQL Injection Prevention Analysis
// ============================================================================
class SecurityDemo {
    public static void runInjectionAnalysis() {
        System.out.println("SQL Injection Vulnerability Analysis:");
        String maliciousInput = "' OR '1'='1";
        
        String unsafeSql = "SELECT * FROM users WHERE id='" + maliciousInput + "' AND pwd='xyz'";
        System.out.println("  Unsafe Query Result String : " + unsafeSql);
        System.out.println("  Risk: Bypasses authentication entirely because condition evaluates to TRUE.");

        String safeSql = "SELECT * FROM users WHERE id=? AND pwd=?";
        System.out.println("  Safe PreparedStatement     : " + safeSql);
        System.out.println("  Protection: Parameters are treated strictly as data literals, neutralizing malicious quotes.");
    }
}

