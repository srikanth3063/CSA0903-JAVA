// TASK 2: Hospital Outpatient Appointment Desk
// ============================================================================
class HospitalDesk extends JFrame {
    private final Map<String, List<String>> deptDoctors = new LinkedHashMap<>();
    private final JTextField patientIdField = new JTextField(12);
    private final JComboBox<String> deptBox = new JComboBox<>();
    private final JComboBox<String> doctorBox = new JComboBox<>();
    private final JComboBox<String> slotBox = new JComboBox<>(new String[]{"09:30 AM", "11:00 AM", "02:30 PM", "04:15 PM"});
    private final JLabel feedbackLabel = new JLabel("Enter details to book.");

    public HospitalDesk() {
        super("Task 2 - Hospital Outpatient Desk");
        deptDoctors.put("Cardiology", Arrays.asList("Dr. Meera Nair", "Dr. Arvind Kumar"));
        deptDoctors.put("Orthopedics", Arrays.asList("Dr. Sanjay Rao", "Dr. Priya Menon"));
        deptDoctors.put("Dermatology", Arrays.asList("Dr. Kavita Das"));

        for (String d : deptDoctors.keySet()) deptBox.addItem(d);

        setLayout(new GridLayout(6, 2, 8, 8));
        add(new JLabel("Patient ID:")); add(patientIdField);
        add(new JLabel("Department:")); add(deptBox);
        add(new JLabel("Doctor:")); add(doctorBox);
        add(new JLabel("Time Slot:")); add(slotBox);
        JButton bookBtn = new JButton("Book Appointment");
        add(bookBtn); add(feedbackLabel);

        refreshDoctors();
        deptBox.addItemListener(e -> {
            if (e.getStateChange() == ItemEvent.SELECTED) refreshDoctors();
        });

        bookBtn.addActionListener(e -> {
            String pid = patientIdField.getText().trim();
            if (pid.isEmpty()) {
                feedbackLabel.setText("Error: Patient ID required!");
                return;
            }
            feedbackLabel.setText("Booked: " + pid + " -> " + doctorBox.getSelectedItem() + " (" + slotBox.getSelectedItem() + ")");
            patientIdField.setText("");
        });

        setDefaultCloseOperation(DO_NOTHING_ON_CLOSE);
        addWindowListener(new WindowAdapter() {
            @Override
            public void windowClosing(WindowEvent e) {
                if (!patientIdField.getText().trim().isEmpty()) {
                    int choice = JOptionPane.showConfirmDialog(HospitalDesk.this,
                            "Booking in progress. Discard and close?", "Confirm Exit", JOptionPane.YES_NO_OPTION);
                    if (choice != JOptionPane.YES_OPTION) return;
                }
                dispose();
            }
        });

        setSize(430, 240);
        setLocationRelativeTo(null);
    }

    private void refreshDoctors() {
        doctorBox.removeAllItems();
        String selectedDept = (String) deptBox.getSelectedItem();
        if (selectedDept != null) {
            for (String doc : deptDoctors.get(selectedDept)) doctorBox.addItem(doc);
        }
    }
}

