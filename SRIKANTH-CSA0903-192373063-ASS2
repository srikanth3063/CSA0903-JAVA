// Q5: Complete the Code - LeaderboardDemo (Generics & Comparator)
// ============================================================================
class Team {
    final String name;
    final int points;
    final int goalDiff;

    Team(String name, int points, int goalDiff) {
        this.name = name;
        this.points = points;
        this.goalDiff = goalDiff;
    }

    @Override
    public String toString() {
        return name + "(" + points + "," + goalDiff + ")";
    }
}

class Leaderboard<T> {
    private final List<T> items = new ArrayList<>();
    private final Comparator<? super T> order;

    Leaderboard(Comparator<? super T> order) {
        this.order = order;
    }

    void add(T item) {
        items.add(item);
    }

    List<T> ranking() {
        // TODO 1: Return a new sorted copy of items using order, without modifying items
        List<T> copy = new ArrayList<>(items);
        copy.sort(order);
        return copy;
    }
}

class LeaderboardDemo {
    public static void runQ5Demo() {
        // TODO 2: Build the comparator: points (high first), then goal difference (high first), then name (A-Z)
        Comparator<Team> byRank = (a, b) -> {
            int cmpPoints = Integer.compare(b.points, a.points);
            if (cmpPoints != 0) return cmpPoints;
            int cmpGoal = Integer.compare(b.goalDiff, a.goalDiff);
            if (cmpGoal != 0) return cmpGoal;
            return a.name.compareTo(b.name);
        };

        Leaderboard<Team> board = new Leaderboard<>(byRank);
        board.add(new Team("Panthers", 9, 4));
        board.add(new Team("Eagles", 9, 6));
        board.add(new Team("Cobras", 6, 1));
        board.add(new Team("Bisons", 9, 4));
        System.out.println(board.ranking());
    }
}

// ============================================================================
// Q6: Complete the Code - Triage (PriorityQueue & Arrival Tie-Breaker)
// ============================================================================
class Patient {
    final String name;
    final int severity;
    final long arrival;

    Patient(String name, int severity, long arrival) {
        this.name = name;
        this.severity = severity;
        this.arrival = arrival;
    }

    @Override
    public String toString() {
        return name + "(S" + severity + ")";
    }
}

class Triage {
    private long counter = 0;

    // TODO 1: Create a PriorityQueue that serves the lowest severity number first and,
    // for equal severity, the earliest arrival first
    private final PriorityQueue<Patient> queue = new PriorityQueue<>((a, b) -> {
        int cmpSev = Integer.compare(a.severity, b.severity);
        if (cmpSev != 0) return cmpSev;
        return Long.compare(a.arrival, b.arrival);
    });

    void admit(String name, int severity) {
        queue.add(new Patient(name, severity, counter++));
    }

    Patient next() {
        return queue.poll();
    }

    public static void runQ6Demo() {
        Triage er = new Triage();
        er.admit("Ravi", 3);
        er.admit("Meena", 1);
        er.admit("John", 3);
        er.admit("Asha", 5);
        er.admit("Kumar", 1);
        er.admit("Lata", 2);

        StringBuilder order = new StringBuilder();
        Patient p;
        while ((p = er.next()) != null) {
            order.append(p).append(' ');
        }
        System.out.println(order.toString().trim());
    }
}

