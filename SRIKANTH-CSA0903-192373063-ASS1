enum PassType {
    NONE(0.0),
    ONE_DAY(50.0),
    MONTHLY(0.0);

    private final double passPurchaseFee;

    PassType(double passPurchaseFee) {
        this.passPurchaseFee = passPurchaseFee;
    }

    public double getPassPurchaseFee() {
        return passPurchaseFee;
    }
}

abstract class Vehicle {
    private final String regNo;
    private final PassType passType;

    protected Vehicle(String regNo, PassType passType) {
        if (regNo == null || regNo.trim().isEmpty()) {
            throw new IllegalArgumentException("Registration number cannot be empty.");
        }
        this.regNo = regNo.toUpperCase();
        this.passType = (passType == null) ? PassType.NONE : passType;
    }

    public String getRegNo() {
        return regNo;
    }

    public PassType getPassType() {
        return passType;
    }

    protected abstract double ratePerHour();

    public double calculateFee(int minutes) {
        return calculateFee(minutes, LocalTime.of(12, 0));
    }

    public double calculateFee(int minutes, LocalTime entryTime) {
        if (minutes < 0) {
            throw new IllegalArgumentException("Duration cannot be negative.");
        }
        if (passType == PassType.MONTHLY || passType == PassType.ONE_DAY) {
            return 0.0;
        }
        if (minutes == 0) {
            return 0.0;
        }
        int hours = (minutes + 59) / 60;
        return hours * ratePerHour();
    }

    @Override
    public boolean equals(Object o) {
        if (o instanceof Vehicle) {
            Vehicle v = (Vehicle) o;
            return this.regNo.equals(v.regNo);
        }
        return false;
    }

    @Override
    public int hashCode() {
        return regNo.hashCode();
    }

    @Override
    public String toString() {
        return getClass().getSimpleName() + "[" + regNo + ", Pass=" + passType + "]";
    }
}

class TwoWheeler extends Vehicle {
    public TwoWheeler(String regNo, PassType passType) {
        super(regNo, passType);
    }

    @Override
    protected double ratePerHour() {
        return 10.0;
    }
}

class Car extends Vehicle {
    public Car(String regNo, PassType passType) {
        super(regNo, passType);
    }

    @Override
    protected double ratePerHour() {
        return 30.0;
    }
}

class ElectricCar extends Car implements Chargeable {
    public ElectricCar(String regNo, PassType passType) {
        super(regNo, passType);
    }

    @Override
    public double chargingFee(int kWh) {
        if (kWh < 0) throw new IllegalArgumentException("kWh cannot be negative.");
        return kWh * 12.0;
    }
}

class EBike extends Vehicle implements Chargeable {
    private static final double FLAT_FEE = 15.0;

    public EBike(String regNo, PassType passType) {
        super(regNo, passType);
    }

    @Override
    protected double ratePerHour() {
        return FLAT_FEE;
    }

    @Override
    public double calculateFee(int minutes, LocalTime entryTime) {
        if (minutes < 0) throw new IllegalArgumentException("Duration cannot be negative.");
        if (getPassType() == PassType.MONTHLY || getPassType() == PassType.ONE_DAY) {
            return 0.0;
        }
        return (minutes == 0) ? 0.0 : FLAT_FEE;
    }

    @Override
    public double chargingFee(int kWh) {
        if (kWh < 0) throw new IllegalArgumentException("kWh cannot be negative.");
        return kWh * 10.0;
    }
}

class DeliveryVan extends Car {
    public DeliveryVan(String regNo, PassType passType) {
        super(regNo, passType);
    }

    @Override
    public double calculateFee(int minutes, LocalTime entryTime) {
        double baseCarFee = super.calculateFee(minutes, entryTime);
        boolean isPeak = !entryTime.isBefore(LocalTime.of(9, 0)) && entryTime.isBefore(LocalTime.of(17, 0));
        return isPeak ? baseCarFee * 2.0 : baseCarFee;
    }
}

class ParkingTicket {
    private static int ticketCounter = 1000;

    private final int ticketId;
    private final Vehicle vehicle;
    private final int floor;
    private final int slot;
    private final LocalTime entryTime;

    public ParkingTicket(Vehicle vehicle, int floor, int slot, LocalTime entryTime) {
        this.ticketId = ++ticketCounter;
        this.vehicle = vehicle;
        this.floor = floor;
        this.slot = slot;
        this.entryTime = entryTime;
    }

    public int getTicketId() { return ticketId; }
    public Vehicle getVehicle() { return vehicle; }
    public int getFloor() { return floor; }
    public int getSlot() { return slot; }
    public LocalTime getEntryTime() { return entryTime; }

    @Override
    public String toString() {
        return String.format("Ticket#%d | %s | Slot[F%d-S%d] | Entry: %s",
                ticketId, vehicle, floor, slot, entryTime);
    }
}

class ParkingSystem {
    private final ParkingTicket[][] slots;
    private final Map<String, ParkingTicket> activeTickets = new HashMap<>();
    private double totalCollection = 0.0;

    public ParkingSystem(int[] slotsPerFloor) {
        slots = new ParkingTicket[slotsPerFloor.length][];
        for (int f = 0; f < slotsPerFloor.length; f++) {
            slots[f] = new ParkingTicket[slotsPerFloor[f]];
        }
    }

    public ParkingTicket parkVehicle(Vehicle vehicle, LocalTime entryTime) {
        if (activeTickets.containsKey(vehicle.getRegNo())) {
            throw new IllegalStateException("Duplicate registration: " + vehicle.getRegNo() + " is already parked.");
        }

        if (vehicle.getPassType() == PassType.ONE_DAY) {
            totalCollection += PassType.ONE_DAY.getPassPurchaseFee();
        }

        for (int f = 0; f < slots.length; f++) {
            for (int s = 0; s < slots[f].length; s++) {
                if (slots[f][s] == null) {
                    ParkingTicket ticket = new ParkingTicket(vehicle, f, s, entryTime);
                    slots[f][s] = ticket;
                    activeTickets.put(vehicle.getRegNo(), ticket);
                    return ticket;
                }
            }
        }
        throw new IllegalStateException("Parking Full! No free slots available for " + vehicle.getRegNo());
    }

    public double exitVehicle(String regNo, int durationMinutes, int kWhCharged) {
        ParkingTicket ticket = activeTickets.remove(regNo.toUpperCase());
        if (ticket == null) {
            throw new IllegalArgumentException("Invalid exit: Vehicle " + regNo + " not found.");
        }

        slots[ticket.getFloor()][ticket.getSlot()] = null;

        Vehicle v = ticket.getVehicle();
        double fee = v.calculateFee(durationMinutes, ticket.getEntryTime());

        if (v instanceof Chargeable && kWhCharged > 0) {
            Chargeable chargeable = (Chargeable) v;
            fee += chargeable.chargingFee(kWhCharged);
        }

        totalCollection += fee;
        return fee;
    }

    public double getTotalCollection() {
        return totalCollection;
    }
}

